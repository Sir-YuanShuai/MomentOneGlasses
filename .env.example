# Optional OpenAI-compatible LanguageModel endpoint.
# Copy this file to .env.local and restart `npm run dev` after changes.
# The API key stays in the Vite server process and is not embedded into browser assets.
AIUI_LLM_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions
AIUI_LLM_API_KEY=
AIUI_LLM_MODEL=your-model-name
AIUI_LLM_API_STYLE=openai-chat-completions

# Default Bearer authentication. For an `api-key` provider, either change
# AIUI_LLM_AUTH_HEADER/SCHEME or put the complete header in AIUI_LLM_HEADERS.
AIUI_LLM_AUTH_HEADER=Authorization
AIUI_LLM_AUTH_SCHEME=Bearer
AIUI_LLM_HEADERS={}
