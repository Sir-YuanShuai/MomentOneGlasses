{
  "name": "moment-one-aiui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "一刻 YiKe · Moment One — AI-native personal memory system for Rokid AI Glasses",
  "main": "app.js",
  "keywords": [
    "aiui",
    "rokid",
    "personal-memory",
    "multimodal-ai"
  ],
  "dependencies": {
    "@yodaos-pkg/ink": "^0.14.0"
  },
  "devDependencies": {
    "vite": "^8.1.5"
  },
  "scripts": {
    "dev": "vite --config dev/vite.config.js",
    "build:preview": "vite build --config dev/vite.config.js",
    "check": "node dev/check.mjs",
    "test:mvp": "node tests/mvp.test.mjs",
    "verify:mvp": "npm run check && npm run test:mvp && npm run build:preview",
    "check:aix-size": "node scripts/check-aix-size.mjs",
    "pack:aix": "node scripts/pack-aix.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
